# Layanan LLM yang kompatibel dengan OpenAI Chat Completions API
# Contoh: https://api.openai.com/v1, https://openrouter.ai/api/v1,
#         http://localhost:11434/v1 (Ollama), gateway internal perusahaan, dll.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Opsional ---
# Batas karakter per potongan teks yang dikirim ke LLM
LLM_CHUNK_CHARS=12000
# Timeout request (detik) dan jumlah percobaan ulang
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 0.0 = paling deterministik (disarankan untuk ekstraksi)
LLM_TEMPERATURE=0
